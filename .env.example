# Copy this file to .env and fill in real values. docker-compose reads .env
# automatically; it is gitignored so secrets don't get committed.

NEO4J_PASSWORD=changeme-please-set-a-password

# Used by the "Generate embeddings" button (liquid/lfm-2.5-embedding-350m:free
# via OpenRouter, which is free). Get a key at https://openrouter.ai/keys —
# without one, that button returns an error but the rest of the app works.
OPENROUTER_API_KEY=

# Optional: override the default host ports.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
