# Public URL the site is served from. Used for canonical links, the sitemap
# and share previews.
VITE_SITE_URL=https://rehbarai.com

# Supabase project (Project Settings -> API). The anon key is safe to ship to
# browsers: row level security limits each learner to their own progress.
# Leave both empty and the site still works, saving progress on the device only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Umami Cloud website ID (Settings -> Websites -> Edit). Empty disables analytics.
VITE_UMAMI_WEBSITE_ID=

# Shown on the privacy page.
VITE_CONTACT_EMAIL=hello@rehbarai.com
