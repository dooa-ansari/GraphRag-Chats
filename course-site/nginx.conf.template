server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

    # Hashed build files never change, so browsers can keep them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Every route is a prerendered file: /chapters/rag -> /chapters/rag/index.html.
    # Redirects for trailing slashes stay relative so they work behind Railway's proxy.
    absolute_redirect off;
    location / {
        try_files $uri $uri/index.html =404;
    }

    error_page 404 /404.html;
}
